# npm run configurar cria .env.local com um segredo aleatório.
# Para configurar manualmente, copie este arquivo para .env.local e preencha:
AUTH_SECRET=""
# Apenas para executar em localhost com npm start. Na Vercel, detecção automática.
AUTH_TRUST_HOST=true
# A API pública e o nome da equipe ficam em lib/configuracao.ts.
# DATABASE_URL não é usada pela aplicação da aula 09.
